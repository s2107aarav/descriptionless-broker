# By default the gateway uses an OS-local state directory outside the project.
# GATEWAY_DATA_DIR=/absolute/path/to/private/runtime
# GATEWAY_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: use a locally installed Ollama model for proposals.
# GATEWAY_OLLAMA_MODEL=qwen2.5:3b
# GATEWAY_OLLAMA_URL=http://127.0.0.1:11434
